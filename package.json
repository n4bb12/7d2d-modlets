    "fast-xml-parser": "^5.3.2",
    "fs-extra": "^11.3.2",
    "lodash": "^4.17.21",
    "node-notifier": "^10.0.1",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3"
  }
}
