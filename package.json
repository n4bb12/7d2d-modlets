{
  "$schema": "http://json.schemastore.org/package",
  "name": "@n4bb12/7d2d-modlets",
  "version": "UNVERSIONED",
  "private": true,
  "description": "7 Days to Die Modlets",
  "keywords": [
    "7 Days to Die",
    "balance",
    "mod",
    "modlet"
  ],
  "homepage": "https://github.com/n4bb12/7d2d-modlets/blob/master/README.md",
