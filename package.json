  "license": "ISC",
  "author": "n4bb12",
  "scripts": {
    "build": "bun scripts/build",
    "build-copy": "bun run build && bun copy",
    "copy": "bun scripts/copy",
    "fix": "bun fmt && bun check",
    "format": "bun fmt",
    "items": "bun scripts/items",
    "json": "bun scripts/json",
    "lint": "bun fmt --check",
    "trader": "bun scripts/economic-value",
    "typecheck": "bun check",
    "watch": "nodemon --watch src --watch scripts --ext xml,md,ts --exec bun build-copy",
    "zombies": "bun scripts/zombies"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
